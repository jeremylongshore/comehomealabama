---
const year = new Date().getFullYear();
---
<footer class="border-line/60 mt-24 border-t bg-white/40">
  <div class="mx-auto max-w-7xl px-6 py-10">
    <div class="grid gap-8 md:grid-cols-4">
      <div>
        <div class="font-display text-gulf-deep text-xl font-medium">
          Mandy <em class="not-italic">Longshore</em>
        </div>
        <p class="text-ink-soft mt-2 text-sm">
          RE/MAX of Gulf Shores
          <br />
          1545 W 2nd St
          <br />
          Gulf Shores, AL 36542
        </p>
      </div>

      <div>
        <div class="text-ink-soft text-xs font-semibold tracking-widest uppercase">
          Direct
        </div>
        <a href="tel:+12515975809" class="text-ink hover:text-gulf-deep mt-2 block text-sm">
          (251) 597-5809
        </a>
        <div class="text-ink-soft mt-4 text-xs font-semibold tracking-widest uppercase">
          Office
        </div>
        <a href="tel:+12512447612" class="text-ink hover:text-gulf-deep mt-2 block text-sm">
          (251) 244-7612
        </a>
      </div>

      <div>
        <div class="text-ink-soft text-xs font-semibold tracking-widest uppercase">
          Listings & Reviews
        </div>
        <a
          href="https://mandy-longshore.sellingcoastalal.com/"
          target="_blank"
          rel="noopener"
          class="text-ink hover:text-gulf-deep mt-2 block text-sm"
        >
          View her listings
        </a>
        <a
          href="https://reviews.birdeye.com/re-max-of-gulf-shores-mandy-longshore-156957454475669"
          target="_blank"
          rel="noopener"
          class="text-ink hover:text-gulf-deep mt-2 block text-sm"
        >
          Read 5★ reviews
        </a>
      </div>

      <div>
        <div class="text-ink-soft text-xs font-semibold tracking-widest uppercase">
          Specialties
        </div>
        <ul class="mt-2 space-y-1 text-sm">
          <li><a href="/specialties/relocation/" class="text-ink hover:text-gulf-deep">Relocation</a></li>
          <li><a href="/specialties/luxury/" class="text-ink hover:text-gulf-deep">Luxury</a></li>
          <li><a href="/specialties/vacation-resorts/" class="text-ink hover:text-gulf-deep">Vacation & Resorts</a></li>
          <li><a href="/specialties/condominiums/" class="text-ink hover:text-gulf-deep">Condominiums</a></li>
          <li><a href="/specialties/new-construction/" class="text-ink hover:text-gulf-deep">New Construction</a></li>
        </ul>
      </div>
    </div>

    <div class="border-line/60 text-ink-soft mt-10 border-t pt-6 text-center text-xs">
      &copy; {year} Mandy Longshore · RE/MAX of Gulf Shores
      <div class="mt-1 opacity-80">
        AL License 000111-09400 · FL License SL3365422
      </div>
      <div class="mt-2 opacity-80">
        Site by{" "}
        <a href="https://intentsolutions.io" class="text-gulf-deep hover:underline">
          Intent Solutions
        </a>
      </div>
    </div>
  </div>
</footer>
