---
import Layout from "@layouts/Layout.astro";
---
<Layout
  title="Journal · Mandy Longshore"
  description="Notes from the coast — neighborhood updates, market observations, and recent stories from Mandy Longshore at RE/MAX of Gulf Shores."
  noindex
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20">
    <span class="border-line text-gulf-deep mb-7 inline-block rounded-full border bg-white/50 px-4 py-1.5 text-xs font-medium tracking-widest uppercase">
      Journal
    </span>
    <h1 class="font-display text-ink text-[clamp(36px,5vw,52px)] leading-tight font-medium tracking-tight">
      Notes from the coast.
    </h1>
    <p class="text-ink-soft mt-5 text-lg">
      Optional Phase C: MDX-powered field journal — neighborhood updates, market color, recent stories. Currently <code>noindex</code> until first post lands.
    </p>
  </section>
</Layout>
