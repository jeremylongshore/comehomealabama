---
import Layout from "@layouts/Layout.astro";
---
<Layout title="Page not found · Mandy Longshore" noindex>
  <section class="mx-auto max-w-2xl px-6 pt-24 pb-24 text-center">
    <div class="text-gulf-deep text-xs font-semibold tracking-widest uppercase">
      404
    </div>
    <h1 class="font-display text-ink mt-4 text-[clamp(40px,7vw,64px)] leading-tight font-medium tracking-tight">
      That page <em class="text-gulf-deep">drifted away</em>.
    </h1>
    <p class="text-ink-soft mt-5 text-lg">
      Try the homepage, or call Mandy directly at{" "}
      <a href="tel:+12515975809" class="text-gulf-deep hover:underline">
        (251) 597-5809
      </a>
      .
    </p>
    <a
      href="/"
      class="bg-gulf-deep text-sand hover:bg-gulf mt-10 inline-flex items-center rounded-full px-6 py-3 text-sm font-medium transition-colors"
    >
      Back home
    </a>
  </section>
</Layout>
