---
import Layout from "@layouts/Layout.astro";
---
<Layout
  title="About Mandy Longshore · RE/MAX of Gulf Shores"
  description="Get to know Mandy Longshore — Realtor with RE/MAX of Gulf Shores, serving Coastal Alabama and West Florida since 2017. Dual-licensed in Alabama and Florida."
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <span class="border-line text-gulf-deep mb-7 inline-block rounded-full border bg-white/50 px-4 py-1.5 text-xs font-medium tracking-widest uppercase">
      About
    </span>
    <h1 class="font-display text-ink text-[clamp(36px,5vw,52px)] leading-tight font-medium tracking-tight">
      I help people <em class="text-gulf-deep">come home</em> to the coast.
    </h1>

    <div class="text-ink-soft mt-8 space-y-5 text-lg leading-relaxed">
      <p class="font-display text-ink text-2xl italic">
        Bio copy lands in Phase B (first-person voice, ~9 years experience, dual-license context, what makes her different).
      </p>
      <p>
        Phase A placeholder — wired to the Sanity <code>siteCopy.about</code> field once the schema lands.
      </p>
    </div>

    <div class="border-line mt-10 grid gap-6 border-t pt-8 sm:grid-cols-2">
      <div>
        <div class="text-ink-soft text-[11px] font-semibold tracking-widest uppercase">
          Alabama License
        </div>
        <div class="text-ink mt-1 font-mono text-base">000111-09400</div>
      </div>
      <div>
        <div class="text-ink-soft text-[11px] font-semibold tracking-widest uppercase">
          Florida License
        </div>
        <div class="text-ink mt-1 font-mono text-base">SL3365422</div>
      </div>
    </div>
  </section>
</Layout>
